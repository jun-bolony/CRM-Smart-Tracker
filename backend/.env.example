# ============================================
# CRM-Smart-Tracker Backend Configuration
# ============================================

# --- Server ---
# Port on which the Express server will listen.
# Default: 3000
PORT=3000

# --- Database ---
# MongoDB Atlas connection string.
# Replace <username>, <password>, and <cluster> with your actual values.
# Example: mongodb+srv://admin:pass123@cluster0.xxxxx.mongodb.net/crm_db
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/database_name

# --- Authentication ---
# Secret key used to sign JWT tokens.
# IMPORTANT: Generate a strong random string (e.g., using `openssl rand -base64 32`).
# Never use this example value in production.
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# --- CORS (Production) ---
# The URL of your frontend application.
# In production (Render), the server WILL NOT start without this variable.
# In local development, you can set it to your Vite dev server.
FRONTEND_URL=http://localhost:5173