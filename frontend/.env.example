# ============================================
# CRM-Smart-Tracker Frontend Configuration
# ============================================

# --- API Backend URL ---
# The full URL of the backend API (Render deployment).
# Example: https://crm-backend.onrender.com
# 
# IMPORTANT (Local Development with Proxy):
# In development mode, you can leave this variable BLANK.
# Vite's built-in proxy (configured in vite.config.ts) will automatically
# forward /api requests to the backend running on localhost:3000.
# 
# IMPORTANT (Production on Vercel):
# This variable MUST be set in the Vercel environment variables panel
# to your live backend URL.
VITE_API_URL=